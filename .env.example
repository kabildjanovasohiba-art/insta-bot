# Bu faylni `.env` deb nomlang va qiymatlarni o'zgartiring:
#   cp .env.example .env

# Majburiy: Telegram bot tokeni (@BotFather'dan olinadi)
BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ixtiyoriy: Admin Telegram ID — bot ishga tushganda va kutilmagan
# xatolik yuz berganda shu foydalanuvchiga xabar yuboriladi
ADMIN_ID=

# Ixtiyoriy: Google Gemini API kaliti (https://aistudio.google.com/apikey)
# Sozlangan bo'lsa — bot video haqida qisqacha qiziqarli tavsif yozadi
# va uni video caption sifatida qo'shadi. Bo'sh bo'lsa — oddiy tavsif.
GEMINI_API_KEY=

# Ishlatiladigan Gemini modeli (standart: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Gemini javobi uchun maksimal kutish vaqti (soniya)
GEMINI_TIMEOUT=120

# Telegram'ga yuboriladigan maksimal fayl hajmi (MB).
# Standart Bot API chegarasi — 50 MB.
MAX_FILESIZE_MB=50

# Bitta video uchun maksimal kutish vaqti (soniya)
DOWNLOAD_TIMEOUT=300

# Instagram cookies fayli (shaxsiy/cheklangan kontent uchun, ixtiyoriy).
# Bo'sh qoldirilsa ishlatilmaydi. cookies.txt formatidagi fayl kerak.
COOKIES_FILE=

# Log darajasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
